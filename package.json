{
  "name": "busca-cct-api",
  "version": "1.0.0",
  "private": true,
  "description": "API backend para busca, extração e alertas de convenções coletivas (CCTs)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/runDailyUpdate.js",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://radar:change-me@127.0.0.1:55432/radar_sindical} DIRECT_URL=${TEST_DATABASE_URL:-postgresql://radar:change-me@127.0.0.1:55432/radar_sindical} ANTHROPIC_API_KEY=test-key PORTAL_AUTH_ENABLED=false npx prisma migrate deploy && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://radar:change-me@127.0.0.1:55432/radar_sindical} DIRECT_URL=${TEST_DATABASE_URL:-postgresql://radar:change-me@127.0.0.1:55432/radar_sindical} ANTHROPIC_API_KEY=test-key PORTAL_AUTH_ENABLED=false node --test --require ts-node/register tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "receita:importar": "ts-node-dev --transpile-only src/jobs/importReceita.ts",
    "sindicato:registrar": "ts-node --transpile-only src/jobs/registerUnion.ts",
    "planilha:sincronizar": "node dist/jobs/syncAdminSheets.js",
    "documentos:importar": "node dist/jobs/importDocuments.js"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "5.0.3",
    "@anthropic-ai/sdk": "^0.68.0",
    "@e965/xlsx": "0.20.3",
    "@google/generative-ai": "^0.24.1",
    "@googleapis/drive": "^26.0.1",
    "@googleapis/sheets": "^18.0.1",
    "@prisma/client": "^6.16.0",
    "axios": "^1.12.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.10",
    "playwright": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.16.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
